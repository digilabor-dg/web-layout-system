{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "layout-pattern.schema.json",
  "title": "LayoutPattern 展示類型",
  "type": "object",
  "required": [
    "type",
    "id",
    "name",
    "group",
    "tags",
    "arrangement",
    "emphasis",
    "imageText",
    "textAmount",
    "slots",
    "items",
    "interaction",
    "responsiveDefault"
  ],
  "additionalProperties": false,
  "properties": {
    "type": {
      "const": "LayoutPattern"
    },
    "id": {
      "$ref": "common.schema.json#/$defs/patternId"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "group": {
      "description": "用途分組 id,只一個",
      "type": "string"
    },
    "tags": {
      "description": "外觀標籤 id,至少一個",
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "arrangement": {
      "enum": [
        "single",
        "list",
        "grid",
        "bento",
        "carousel",
        "tabs"
      ]
    },
    "emphasis": {
      "enum": [
        "none",
        "lead1",
        "lead2"
      ]
    },
    "imageText": {
      "enum": [
        "stacked",
        "side",
        "overlay",
        "none"
      ]
    },
    "textAmount": {
      "enum": [
        "headline",
        "summary",
        "paragraph"
      ]
    },
    "interaction": {
      "enum": [
        "none",
        "carousel",
        "tabs",
        "marquee",
        "play",
        "accordion",
        "poll"
      ]
    },
    "slots": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "role",
          "count",
          "image"
        ],
        "additionalProperties": false,
        "properties": {
          "role": {
            "description": "位置名稱,例如 lead、rest、card",
            "type": "string",
            "minLength": 1
          },
          "count": {
            "oneOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "const": "rest"
              }
            ]
          },
          "image": {
            "description": "圖片角色的允許清單;不寫數字比例",
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "$ref": "common.schema.json#/$defs/imageRole"
            }
          }
        }
      }
    },
    "items": {
      "description": "則數範圍;max 為 null 表示不限",
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "oneOf": [
            {
              "type": "integer",
              "minimum": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "pageSize": {
          "description": "無限載入每次的則數",
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "responsiveDefault": {
      "description": "只存手機與電腦;null 表示尚未定義",
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "mobile",
            "desktop"
          ],
          "additionalProperties": false,
          "properties": {
            "mobile": {
              "$ref": "common.schema.json#/$defs/responsiveEntry"
            },
            "desktop": {
              "$ref": "common.schema.json#/$defs/responsiveEntry"
            }
          }
        }
      ]
    },
    "inferred": {
      "description": "由 Claude 推定、尚待確認的欄位名稱",
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "gallery": {
      "description": "圖輯型(例如圖片牆):每則新聞的 gallery 張數範圍",
      "type": "object",
      "required": [
        "min",
        "max"
      ],
      "additionalProperties": false,
      "properties": {
        "min": {
          "type": "integer",
          "minimum": 1
        },
        "max": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
