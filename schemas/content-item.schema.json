{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "content-item.schema.json",
  "title": "ContentItem 新聞則",
  "description": "標題字數不另存,需要時由程式從 title 計算",
  "type": "object",
  "required": ["type", "id", "contentType", "title", "url", "publishedAt", "images"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "ContentItem" },
    "id": { "$ref": "common.schema.json#/$defs/id" },
    "contentType": { "$ref": "common.schema.json#/$defs/id" },
    "category": { "$ref": "common.schema.json#/$defs/id" },
    "title": { "type": "string", "minLength": 1 },
    "summary": { "description": "摘要(文字量為 summary 或 paragraph 時使用)", "type": "string" },
    "author": {
      "description": "作者(觀點類使用)",
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": { "name": { "type": "string", "minLength": 1 } }
    },
    "url": { "type": "string", "pattern": "^/" },
    "publishedAt": { "type": "string", "format": "date-time" },
    "images": {
      "description": "key 對應圖片角色;缺少哪一份由規則 item-crops 回報",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "main": { "$ref": "common.schema.json#/$defs/imageFile" },
        "square": { "$ref": "common.schema.json#/$defs/imageFile" },
        "video": { "$ref": "common.schema.json#/$defs/imageFile" }
      }
    },
    "gallery": { "description": "P16 圖輯用的 1:1 圖片", "type": "array", "items": { "$ref": "common.schema.json#/$defs/imageFile" } }
  }
}
